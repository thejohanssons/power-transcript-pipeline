{
  "name": "@eip/runtime-shadow",
  "version": "0.1.0",
  "description": "Staging-only Cloudflare fixture parity runtime for EIP Azure replacement",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --env staging",
    "deploy:dry-run": "wrangler deploy --env staging --dry-run",
