{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eip-runtime-shadow",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "staging": {
      "vars": {
        "ENVIRONMENT": "staging",
        "SHADOW_MODE": "fixture_parity",
        "AZURE_ARTIFACT_READER_URL": "https://eip-api-worker-staging.homeassistant-8d3.workers.dev/internal/runtime-shadow/azure-artifacts/",
        "AZURE_OPENAI_ENDPOINT": "https://atlassian-rovo-forge.openai.azure.com/openai/v1",
        "AZURE_OPENAI_DEPLOYMENT": "gpt-5.6-terra"
      },
      "d1_databases": [
        {
          "binding": "SHADOW_DB",
          "database_name": "eip-runtime-shadow-staging",
          "database_id": "c7474ecb-ff28-4788-9108-15d29a022c7b",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "SHADOW_ARTIFACTS",
          "bucket_name": "eip-runtime-shadow-staging-fixtures"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "FIXTURE_JOBS",
            "queue": "eip-runtime-shadow-staging-jobs"
          },
          {
            "binding": "CONTINUOUS_EXPORT_JOBS",
            "queue": "eip-runtime-shadow-staging-continuous-export-jobs"
          }
        ],
        "consumers": [
          {
            "queue": "eip-runtime-shadow-staging-jobs",
            "max_batch_size": 1,
            "max_batch_timeout": 30,
            "max_retries": 3
          },
          {
            "queue": "eip-runtime-shadow-staging-continuous-export-jobs",
            "max_batch_size": 1,
            "max_batch_timeout": 30,
            "max_retries": 3
          }
        ]
      }
    }
  }
}
