# ============================================================
# EIP Local Cockpit Server — Environment variable template
# Copy this file to .env.local and fill in the real values.
# .env.local is git-ignored and must never be committed.
# See RUNBOOK.md for credential provisioning instructions.
# ============================================================

# ── Cloudflare account ───────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=8d39b30a61583a7802a2ea82195b7da3 

# ── Production runtime D1 (READ-ONLY token) ─────────────────
# Token must have: D1:Read permission for database RUNTIME_D1_DATABASE_ID only.
# It must NOT have D1:Write or any other permission.
CLOUDFLARE_D1_READ_TOKEN=REPLACE_WITH_LOCAL_SECRET
RUNTIME_D1_DATABASE_ID=953bd671-7f96-450c-96da-736ecbfdf19d

# ── R2: Not used in this POC ─────────────────────────────────
# R2 access requires either the S3-compatible API (AWS SigV4) or a Workers
# binding. Neither is available in this localhost POC. R2 is deferred to a
# future production design. No R2 credentials are required.

# ── Dedicated feedback D1 (WRITE token, isolated DB only) ───
# Token must have: D1:Read + D1:Write permission for FEEDBACK_D1_DATABASE_ID ONLY.
# It must NOT have access to the runtime D1.
# Create the feedback DB first: wrangler d1 create eip-local-feedback
CLOUDFLARE_FEEDBACK_TOKEN=REPLACE_WITH_LOCAL_SECRET
FEEDBACK_D1_DATABASE_ID=6611d066-72be-4d70-ab40-31b6aceea1f5

# ── Runtime review command (server-side only) ─────────────────
# Fixed Worker command endpoint; never expose this URL/token to browser code.
RUNTIME_REVIEW_API_URL=https://eip-cloudflare-runtime-staging.example.workers.dev
# Must match the Worker secret REVIEW_DECISION_TOKEN.
RUNTIME_REVIEW_DECISION_TOKEN=REPLACE_WITH_LOCAL_SECRET

# ── Server config (optional) ─────────────────────────────────
# HOST must be 127.0.0.1 or localhost. Any other value is rejected at startup.
PORT=4321
HOST=127.0.0.1

# ── Pre-flight operator identification ───────────────────────
# Both are REQUIRED before running npm run preflight.
PREFLIGHT_OPERATOR=your-name
# Reference to an approved backup or export of the production runtime D1 database.
# Must be non-empty. Example: "D1 export 2026-08-11T09:00Z via wrangler d1 export"
PREFLIGHT_BACKUP_REF=
