{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "eip-exco-cockpit",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public"
  },
  // No D1, R2, Queue, or secret bindings — synthetic data only.
  // Real-data promotion is blocked until Cloudflare Access is configured
  // and a separate constrained D1 read-model design is approved.
  "env": {
    "staging": {
      "name": "eip-exco-cockpit-staging"
    }
  }
}
